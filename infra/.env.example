# Hosted Zone ID for your Route 53 domain (e.g. resume.yourdomain.com)
HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ

# Domain / Zone Name
ZONE_NAME=resume.grtmkr.com

# AWS CodeConnections / CodeStar Connection ARN
CODESTAR_CONNECTION_ARN=arn:aws:codeconnections:us-east-2:123456789012:connection/00000000-0000-0000-0000-000000000000

# GitHub repository details (optional)
GITHUB_OWNER=your-github-username
GITHUB_REPO=resumesite
GITHUB_BRANCH=main

# Contact Information (kept out of git, injected at build time)
HUGO_CONTACT_EMAIL=user@example.com
HUGO_CONTACT_PHONE=123-456-7890

# Analytics (Optional)
UMAMI_WEBSITE_ID=your-umami-website-id


